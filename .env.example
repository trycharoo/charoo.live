# pnpm setup fills missing local values and generates MESSAGE_KEY.
NODE_ENV=development
WEB_ORIGIN=http://127.0.0.1:5173
MESSAGE_KEY=
EMAIL_FROM="Charoo <hello@localhost>"
MAILPIT_URL=http://127.0.0.1:8025

# Optional providers: configure each complete group to enable its integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MEDIA_SCANNER_URL=
MEDIA_SCANNER_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
RESEND_API_KEY=

# Set only when your ingress strips and writes this header itself.
TRUSTED_CLIENT_IP_HEADER=
