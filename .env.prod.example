# Copy to an ignored file such as .env.production, or supply process variables.
NODE_ENV=production
WEB_ORIGIN=https://charoo.example
# Generate once with: openssl rand -base64 32. Retain it across deployments.
MESSAGE_KEY=
EMAIL_FROM="Charoo <hello@your-domain.example>"
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MEDIA_SCANNER_URL=
MEDIA_SCANNER_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
TRUSTED_CLIENT_IP_HEADER=

# Fleet bucket names and cloud credentials belong to the Celld host, not here.
