# Copy to an ignored file such as .env.production, or supply process variables.
NODE_ENV=production
WEB_ORIGIN=https://charoo.example
# Generate once with: openssl rand -base64 32. Retain it across deployments.
MESSAGE_KEY=

# Optional Resend HTTP email: configure both values to enable email sign-in.
# EMAIL_FROM="Charoo <hello@your-domain.example>"
# RESEND_API_KEY=

# Optional Google login: uncomment and configure both values.
# Register ${WEB_ORIGIN}/api/auth/google/callback on the same Google OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional authenticated media scanner: configure both values to enable uploads.
# MEDIA_SCANNER_URL=
# MEDIA_SCANNER_TOKEN=

# Optional LiveKit video calls: configure all three values and enable video in admin settings.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional assistant: configure all three values and enable AI in admin settings.
# The endpoint must implement OpenAI-compatible chat completions.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# Set only when your ingress strips and writes this header itself.
# TRUSTED_CLIENT_IP_HEADER=

# D1, Durable Objects, R2 and Queues use wrangler.jsonc bindings.
# Fleet bucket names and cloud credentials belong to the Celld host.
# Application PostgreSQL, Redis, S3 and SMTP connection secrets are unnecessary.
